[Unit]
Description=Draft the team daily standup reply for approval
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/standup-post
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# The script caps each claude run at 20 minutes and redrafts at most once,
# so allow two runs plus room for the rest.
TimeoutStartSec=45min
UMask=0077
