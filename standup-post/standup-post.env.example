# Copy to ~/.config/standup-post.env and replace the placeholders.
# bin/standup-post refuses to run when the file or a key is missing.
STANDUP_CHANNEL=C0000000000   # Slack channel ID where the standup bot posts
STANDUP_SUBTEAM=S0000000000   # Slack user group the bot mentions in the thread
STANDUP_SELF=U0000000000      # your Slack user ID, to detect an existing reply
STANDUP_TEAM='My Team'        # team name: letters, digits, spaces, . _ -
