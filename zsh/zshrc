# The following lines were added by compinstall
#
source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"

zstyle :compinstall filename "${HOME}/.zshrc"

autoload -Uz compinit
compinit

autoload -U colors
colors

# End of lines added by compinstall
# Lines configured by zsh-newuser-install
HISTFILE=~/.histfile
HISTSIZE=1000
SAVEHIST=1000
setopt beep nomatch
unsetopt appendhistory autocd extendedglob notify
bindkey -e
# End of lines configured by zsh-newuser-install

export EDITOR=vim

export CDPATH=.:$HOME:$HOME/src:$HOME/src/github.com:$HOME/src/github.com/maxgio92

export GIT_CODE_FOLDER="${HOME}/src"

# Reverse search key binding
bindkey '^R' history-incremental-search-backward

# Aliases
source $HOME/.shell_aliases/shell_aliases

set -o vi

# Path
path+=($HOME/.local/bin)
path+=($HOME/.krew/bin)
path+=($HOME/go/bin)
path+=($HOME/.git-dclone)
path+=($HOME/.local/git-dclone)
path+=($HOME/.goland/bin)

# FZF
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# Setup Brew bins in PATH
[ -d /home/linuxbrew ] && \
	eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

# Direnv
 eval "$(direnv hook zsh)"

export WORKSTATION_USER=massimiliano-giovagnoli

# The next line updates PATH for the Google Cloud SDK.
[ -f "$HOME/.local/google-cloud-sdk/path.zsh.inc" ] && \
	. '/var/home/massimiliano.giovagnoli/.local/google-cloud-sdk/path.zsh.inc'

# The next line enables shell command completion for gcloud.
[ -f "$HOME/.local/google-cloud-sdk/completion.zsh.inc" ] && \
	. '/var/home/massimiliano.giovagnoli/.local/google-cloud-sdk/completion.zsh.inc'

alias vim=nvim
alias vi=nvim

# Machine-local settings kept out of the public repository.
[ -f ~/.zshrc.local ] && source ~/.zshrc.local

function light() {
	ln -sf "$HOME/.config/alacritty/themes/themes/gruvbox_light.toml" \
		"$HOME/.config/alacritty/themes/themes/_active.toml"
        sed -i "s|background = \"dark\"|background = \"light\"|g" $HOME/.config/nvim/init.lua
	touch ~/.config/alacritty/alacritty.toml
	dconf write /org/gnome/desktop/interface/color-scheme "'default'"
	dconf write /org/gnome/desktop/interface/gtk-theme "'Adwaita'"
}

function dark() {
	ln -sf "$HOME/.config/alacritty/themes/themes/gruvbox_dark.toml" \
		"$HOME/.config/alacritty/themes/themes/_active.toml"
        sed -i "s|background = \"light\"|background = \"dark\"|g" $HOME/.config/nvim/init.lua
	touch ~/.config/alacritty/alacritty.toml
	dconf write /org/gnome/desktop/interface/color-scheme "'prefer-dark'"
	dconf write /org/gnome/desktop/interface/gtk-theme "'Adwaita-dark'"
}

function apkdepends() {
	wolfictl apk ls https://packages.wolfi.dev/os/x86_64/APKINDEX.tar.gz --latest --json | jq -r "select(.Dependencies) | select(.Dependencies | index(\"$1\")) | .Origin" | sort -u
}
