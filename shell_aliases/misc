alias watch='watch '
alias vimfzf="vim -o \$(fzf)"
alias batfzf="fzf --preview 'bat --style=numbers --color=always --line-range :500 {}'"
alias box="distrobox enter wolfi_distrobox -- zsh"
alias tarcat='tar --extract --to-stdout --file "$@" 2>/dev/null'
alias tarls='tar --list --file "$@" 2>/dev/null'
kalias() {
  alias k="docker exec -it $1 kubectl"
}
alias apk-reindex='melange index -m -s packages/x86_64/APKINDEX.tar.gz --signing-key local-melange.rsa packages/x86_64/*.apk && mv APKINDEX.tar.gz packages/x86_64/APKINDEX.tar.gz'
# personal-watch: drain the notification inbox in the terminal (read + archive)
pw() {
  local d="${XDG_STATE_HOME:-$HOME/.local/state}/personal-watch"
  shopt -s nullglob 2>/dev/null
  local f=("$d"/inbox/*)
  [ ${#f[@]} -eq 0 ] && { echo "inbox empty"; return 0; }
  cat "${f[@]}"
  mkdir -p "$d/archive" && mv "${f[@]}" "$d/archive/"
}
