#!/usr/bin/env bash
# Post an approved review-pr block as one COMMENT review with inline comments.
#
# Usage: gh-review-post <pr-url> --commit <sha> --body-file PATH
#
# The URL must be https://github.com/OWNER/REPO/pull/N; owner, repo, and PR
# number are derived only from it. --commit is the reviewed head, 40
# lowercase hex. The text comes only from the file. Every other input shape
# is a policy violation and exits 64; a bare or --help call exits 2. A body
# line starting 'Verdict: skip' or 'Skip-reason:' (a skip report header)
# exits 64 before any gh call.
#
# Split, deterministic and adding no text:
# - Preamble: every line before the first line starting '### '. It holds the
#   verdict and always goes to the review body; a missing or blank preamble
#   exits 64.
# - Finding: from a '### ' heading line through the first following line
#   starting 'Reference: '. No such line before the next '### ' or EOF exits
#   64, as does any non-blank line between a Reference line and the next
#   '### ' heading.
# - Inline: a finding whose Reference line is exactly
#   Reference: `<path>:head:<N>` (side RIGHT) or Reference: `<path>:base:<N>`
#   (side LEFT), where <path> is in the PR files list with a patch and N is
#   commentable in that patch's hunks: an added or context line in new-file
#   numbering for RIGHT, a deleted line in old-file numbering for LEFT. Its
#   comment body is exactly the lines strictly between the heading line and
#   the Reference line, leading and trailing blank lines trimmed. The heading
#   line and the Reference line are dropped.
# - Review body: the preamble, then every other finding verbatim from heading
#   through Reference line plus the blank lines that followed it, in file
#   order, with trailing blank lines trimmed. That covers a bare `file:line`
#   or other Reference form, a path missing from the files list, a file with
#   no patch, a line outside the hunks, and a finding with no prose.
#
# Reads: GET repos/OWNER/REPO/pulls/N/files (paginated), then, just before
# the POST, gh pr view for headRefOid and changedFiles. A head that differs
# from --commit exits 64; more than 3000 changed files warns, since the files
# list stops there and later files fall back to the body.
#
# Write: POST repos/OWNER/REPO/pulls/N/reviews on github.com with
# {commit_id, event: "COMMENT", body, comments: [{path, line, side, body}]}.
# The hostname is pinned so GH_HOST cannot redirect the calls away from the
# host the URL was validated against. Any failure, a 422 included, prints
# gh's stderr and the response body and exits non-zero, with no retry.
# https://docs.github.com/en/rest/pulls/reviews#create-a-review-for-a-pull-request
# https://docs.github.com/en/rest/pulls/pulls#list-pull-requests-files

set -euo pipefail

readonly EX_USAGE=2
readonly EX_POLICY=64

usage() {
  echo "usage: gh-review-post <pr-url> --commit <sha> --body-file PATH" >&2
  exit "$EX_USAGE"
}

policy() {
  echo "gh-review-post: $*" >&2
  exit "$EX_POLICY"
}

[ $# -eq 0 ] && usage
for arg in "$@"; do
  case "$arg" in
    -h|--help) usage ;;
  esac
done

url=""
commit=""
commit_given=0
body_file=""
body_file_given=0
while [ $# -gt 0 ]; do
  case "$1" in
    --commit)
      [ $# -ge 2 ] || policy "--commit needs a sha"
      [ "$commit_given" -eq 0 ] || policy "--commit given twice"
      commit="$2"
      commit_given=1
      shift 2
      ;;
    --body-file)
      [ $# -ge 2 ] || policy "--body-file needs a path"
      [ "$body_file_given" -eq 0 ] || policy "--body-file given twice"
      body_file="$2"
      body_file_given=1
      shift 2
      ;;
    --commit=*)
      policy "use '--commit SHA', not '--commit=SHA'"
      ;;
    --body-file=*)
      policy "use '--body-file PATH', not '--body-file=PATH'"
      ;;
    -*)
      policy "unknown flag '$1'; only --commit and --body-file are accepted"
      ;;
    *)
      [ -z "$url" ] || policy "extra argument '$1'; one pull request URL only"
      url="$1"
      shift
      ;;
  esac
done

[ -n "$url" ] || policy "missing pull request URL"
[ "$commit_given" -eq 1 ] || policy "missing --commit SHA"
[[ "$commit" =~ ^[0-9a-f]{40}$ ]] || policy "--commit '$commit' is not a 40-character lowercase hex sha"
[ "$body_file_given" -eq 1 ] || policy "missing --body-file PATH"
[ -n "$body_file" ] || policy "--body-file path is empty"
[ "$body_file" != "-" ] || policy "body must be a file, not stdin ('-')"
[ -f "$body_file" ] && [ -r "$body_file" ] || policy "body file '$body_file' is missing or unreadable"
[ -s "$body_file" ] || policy "body file '$body_file' is empty"

# Owner and repo follow GitHub's name grammar, so nothing else can reach
# the API path.
url_re='^https://github\.com/([A-Za-z0-9-]+)/([A-Za-z0-9._-]+)/pull/([0-9]+)$'
if [[ ! "$url" =~ $url_re ]]; then
  policy "'$url' is not a pull request URL (expected https://github.com/OWNER/REPO/pull/N)"
fi
owner="${BASH_REMATCH[1]}"
repo="${BASH_REMATCH[2]}"
case "$repo" in
  .|..) policy "'$url' is not a pull request URL (repository name '$repo')" ;;
esac
pr="${BASH_REMATCH[3]}"

mapfile -t lines < "$body_file"
nlines=${#lines[@]}
for line in "${lines[@]}"; do
  case "$line" in
    'Verdict: skip'*|'Skip-reason:'*)
      policy "body file holds a skip report header ('$line'); a skip report has nothing to post"
      ;;
  esac
done

for tool in gh jq; do
  command -v "$tool" >/dev/null 2>&1 || policy "$tool is required but not on PATH"
done

is_blank() { [[ "$1" =~ ^[[:space:]]*$ ]]; }
is_heading() { [[ "$1" == '### '* ]]; }

# Preamble: lines [0, first_heading).
first_heading=$nlines
for ((i = 0; i < nlines; i++)); do
  if is_heading "${lines[i]}"; then first_heading=$i; break; fi
done
has_verdict=0
for ((i = 0; i < first_heading; i++)); do
  is_blank "${lines[i]}" || { has_verdict=1; break; }
done
[ "$has_verdict" -eq 1 ] || policy "no verdict before the first '### ' finding; the verdict stays in the review body"

# Findings: seg_start is the heading, seg_ref the Reference line, seg_end one
# past the blank lines that follow it.
seg_start=()
seg_ref=()
seg_end=()
i=$first_heading
while [ "$i" -lt "$nlines" ]; do
  ref=-1
  for ((j = i + 1; j < nlines; j++)); do
    is_heading "${lines[j]}" && break
    if [[ "${lines[j]}" == 'Reference: '* ]]; then ref=$j; break; fi
  done
  [ "$ref" -ge 0 ] || policy "finding '${lines[i]}' has no Reference line before the next '### ' heading or the end of the file"
  for ((k = ref + 1; k < nlines; k++)); do
    is_heading "${lines[k]}" && break
    is_blank "${lines[k]}" || policy "line $((k + 1)) ('${lines[k]}') follows a Reference line outside any finding"
  done
  seg_start+=("$i")
  seg_ref+=("$ref")
  seg_end+=("$k")
  i=$k
done

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

pull="repos/${owner}/${repo}/pulls/${pr}"

# --paginate prints one JSON array per page; jq -s merges them.
files="$(gh api --hostname github.com "$pull/files" --paginate | jq -s '[.[][] | {filename, patch}]')"

# commentable SIDE N reads a unified-diff patch on stdin and succeeds when
# line N is commentable on SIDE. A malformed hunk header disables counting
# until the next valid one, so an unparsed hunk is never commentable.
commentable() {
  awk -v side="$1" -v n="$2" '
    BEGIN { n = n + 0; found = 0; inh = 0 }
    /^@@ / {
      inh = 0
      if ($2 !~ /^-[0-9]+(,[0-9]+)?$/ || $3 !~ /^\+[0-9]+(,[0-9]+)?$/) next
      split(substr($2, 2), o, ","); split(substr($3, 2), w, ",")
      old = o[1] + 0; new = w[1] + 0; inh = 1
      next
    }
    !inh { next }
    /^\+/ { if (side == "RIGHT" && new == n) found = 1; new++; next }
    /^-/ { if (side == "LEFT" && old == n) found = 1; old++; next }
    /^\\/ { next }
    { if (side == "RIGHT" && new == n) found = 1; old++; new++ }
    END { exit found ? 0 : 1 }
  '
}

# write_lines FILE FROM TO writes lines[FROM..TO] joined by newlines, with no
# trailing newline, so the text is exactly the file's lines.
write_lines() {
  local out="$1" from="$2" to="$3" j
  {
    [ "$from" -le "$to" ] || return 0
    printf '%s' "${lines[from]}"
    for ((j = from + 1; j <= to; j++)); do printf '\n%s' "${lines[j]}"; done
  } > "$out"
}

# shellcheck disable=SC2016 # the backticks are literal Markdown, not expansions
ref_re='^Reference: `(.+):(head|base):([1-9][0-9]*)`$'
body_idx=()
for ((i = 0; i < first_heading; i++)); do body_idx+=("$i"); done
: > "$work/comments.ndjson"
for s in "${!seg_start[@]}"; do
  start=${seg_start[s]}
  ref=${seg_ref[s]}
  end=${seg_end[s]}
  inline=0
  if [[ "${lines[ref]}" =~ $ref_re ]]; then
    path="${BASH_REMATCH[1]}"
    side=RIGHT
    [ "${BASH_REMATCH[2]}" = head ] || side=LEFT
    num="${BASH_REMATCH[3]}"
    patch="$(jq -r --arg p "$path" 'first(.[] | select(.filename == $p) | .patch // empty) // empty' <<< "$files")"
    from=$((start + 1))
    to=$((ref - 1))
    while [ "$from" -le "$to" ] && is_blank "${lines[from]}"; do from=$((from + 1)); done
    while [ "$to" -ge "$from" ] && is_blank "${lines[to]}"; do to=$((to - 1)); done
    if [ -n "$patch" ] && [ "$from" -le "$to" ] && commentable "$side" "$num" <<< "$patch"; then
      inline=1
      write_lines "$work/comment" "$from" "$to"
      jq -nc --arg path "$path" --argjson line "$num" --arg side "$side" --rawfile body "$work/comment" \
        '{path: $path, line: $line, side: $side, body: $body}' >> "$work/comments.ndjson"
    fi
  fi
  if [ "$inline" -eq 0 ]; then
    for ((j = start; j < end; j++)); do body_idx+=("$j"); done
  fi
done

# Review body: the kept lines in file order, trailing blank lines trimmed.
last=$((${#body_idx[@]} - 1))
while [ "$last" -ge 0 ] && is_blank "${lines[body_idx[last]]}"; do last=$((last - 1)); done
{
  for ((j = 0; j <= last; j++)); do
    [ "$j" -eq 0 ] || printf '\n'
    printf '%s' "${lines[body_idx[j]]}"
  done
} > "$work/body"

# Live head check, as close to the POST as possible.
view="$(gh pr view "$url" --json headRefOid,changedFiles)"
head="$(jq -r '.headRefOid // empty' <<< "$view")"
changed="$(jq -r '.changedFiles // 0' <<< "$view")"
[ "$head" = "$commit" ] || policy "PR head moved: live head is '$head', --commit is '$commit'; re-review before posting"
if [[ "$changed" =~ ^[0-9]+$ ]] && [ "$changed" -gt 3000 ]; then
  echo "gh-review-post: warning: the PR changes $changed files; the files list stops at 3000, so findings on later files went to the review body" >&2
fi

jq -n --arg commit "$commit" --rawfile body "$work/body" --slurpfile comments "$work/comments.ndjson" \
  '{commit_id: $commit, event: "COMMENT", body: $body, comments: $comments}' > "$work/payload.json"

# gh's stderr is kept apart from the URL on stdout, so a warning (an update
# notice, a deprecation) cannot land in the caller's captured URL.
out="$(gh api --hostname github.com --method POST "$pull/reviews" --input - --jq '.html_url' \
  < "$work/payload.json" 2>"$work/err")" && status=0 || status=$?

if [ "$status" -ne 0 ]; then
  # On a non-2xx response gh prints its status on stderr and GitHub's JSON
  # error body on stdout, skipping --jq. Surface both. No retry and no
  # per-comment fallback: either would post something other than the
  # approved review.
  cat "$work/err" >&2
  [ -z "$out" ] || printf '%s\n' "$out" >&2
  exit "$status"
fi
cat "$work/err" >&2
printf '%s\n' "$out"
