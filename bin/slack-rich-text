#!/usr/bin/env python3
"""Convert a plain-text Slack draft into a Block Kit rich_text blocks array.

Reads the draft on stdin and prints the JSON array on stdout. Lines that start
with "•" or "- " become bullet list items; other non-empty lines become plain
sections. Markdown links, [text](https://...), and bare URLs become link
elements, so Slack renders every one of them as a clickable link.
"""
import json
import re
import sys

LINK = re.compile(r"\[([^\]\n]+)\]\((https?://[^)\s]+)\)|(https?://[^\s<>]+)")
BULLET = re.compile(r"^\s*(?:•|-)\s+")


def inline(text):
    elements, pos = [], 0
    for match in LINK.finditer(text):
        if match.start() > pos:
            elements.append({"type": "text", "text": text[pos:match.start()]})
        if match.group(2):
            elements.append({"type": "link", "url": match.group(2), "text": match.group(1)})
        else:
            elements.append({"type": "link", "url": match.group(3)})
        pos = match.end()
    if pos < len(text):
        elements.append({"type": "text", "text": text[pos:]})
    return elements or [{"type": "text", "text": " "}]


def section(text):
    return {"type": "rich_text_section", "elements": inline(text)}


def blocks(draft):
    out, items = [], []

    def flush():
        if items:
            out.append({"type": "rich_text_list", "style": "bullet", "elements": list(items)})
            items.clear()

    for line in draft.splitlines():
        if BULLET.match(line):
            items.append(section(BULLET.sub("", line, count=1)))
            continue
        flush()
        if line.strip():
            if out:
                out.append({"type": "rich_text_section", "elements": [{"type": "text", "text": "\n"}]})
            out.append(section(line.strip()))
    flush()
    return [{"type": "rich_text", "elements": out}]


if __name__ == "__main__":
    json.dump(blocks(sys.stdin.read()), sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")
