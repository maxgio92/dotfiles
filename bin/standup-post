#!/usr/bin/env bash
# Reply to today's team daily standup thread through headless claude and its
# Slack plugin, after the user approves the draft.
#
#   standup-post            draft today's reply, save it, notify (standup-post.timer)
#   standup-post --show     print the saved draft and its thread ts
#   standup-post --approve  post the saved draft verbatim
#   standup-post --discard  drop the saved draft
#   standup-post --dry-run  print a draft without saving it
set -euo pipefail

# The bot posts at $POST_HOUR:30 Europe/Rome while the host clock is UTC, so all date
# maths runs in the bot's timezone.
ZONE=Europe/Rome
# The hour the bot posts the EU standup thread, in $ZONE.
POST_HOUR=11

state_dir="$HOME/.local/state/standup-post"
last_file="$state_dir/last-posted"
sent_file="$state_dir/sent"
# The saved draft, and "<today> <thread_ts>" for the thread it answers.
draft_file="$state_dir/draft"
pending_file="$state_dir/pending"
skill_dir="$HOME/.claude/skills/standup-update"
rules_dir="$HOME/.claude/hooks/communication-rules"

log() { printf 'standup-post: %s\n' "$*" >&2; }
die() { log "$*"; exit 1; }

# Hook mode, called by claude for slack_send_message during a run. The prompt
# alone cannot stop a model steered by Slack or transcript text from posting
# elsewhere or twice, so the pre hook denies (exit 2) any send outside a
# thread of $CHANNEL started between $oldest and $latest, or after a send
# landed today; the post hook records a landed send as "<today> <thread_ts>".
# Counting in PostToolUse keeps a send another hook denied retryable. The
# trusted bounds and channel come from the main run as arguments, never from
# tool input or the env file. The pre hook also denies a message that cites a
# pull request as a bare number (see pr_refs), since the standup-update skill
# requires the full URL, and anything but the saved draft, verbatim, to the
# thread it was drafted for: only --approve offers the send tool, so every
# send needs a pending draft for today.
send_gate() {
  local phase=$1 day=$2 lo=$3 hi=$4 want=$5 input channel thread message refs draft
  input=$(cat)
  case $phase in
    pre)
      # Exit 1 would let the call through, so bad arguments or unreadable
      # input deny too.
      [[ $day =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ && $lo =~ ^[0-9]+$ && $hi =~ ^[0-9]+$ && $want =~ ^C[A-Z0-9]+$ ]] || {
        echo "standup-post --send-gate pre needs <today> <oldest> <latest> <channel>" >&2; exit 2
      }
      channel=$(jq -r '.tool_input.channel_id // ""' <<<"$input") || exit 2
      thread=$(jq -r '.tool_input.thread_ts // ""' <<<"$input") || exit 2
      message=$(jq -r '.tool_input.message // ""' <<<"$input") || exit 2
      if [ "$channel" != "$want" ]; then
        echo "standup-post only posts to channel $want" >&2; exit 2
      fi
      if ! [[ $thread =~ ^[0-9]{1,12}(\.[0-9]+)?$ ]]; then
        echo "standup-post only posts as a thread reply; set thread_ts to the parent ts" >&2; exit 2
      fi
      if [ "${thread%%.*}" -lt "$lo" ] || [ "${thread%%.*}" -ge "$hi" ]; then
        echo "standup-post only replies to a thread started in today's standup hour" >&2; exit 2
      fi
      if ! pending_on "$day" || [ "$thread" != "$pending_ts" ]; then
        echo "standup-post only replies to the thread of today's approved draft" >&2; exit 2
      fi
      draft=$(<"$draft_file") || exit 2
      if [ "$(trim "$message")" != "$(trim "$draft")" ]; then
        echo "standup-post only posts the approved draft verbatim" >&2; exit 2
      fi
      refs=$(pr_refs "$message") || exit 2
      if [ -n "$refs" ]; then
        echo "standup-post denied a bare pull request reference: ${refs//$'\n'/, }. Replace each with the full https://github.com/<owner>/<repo>/pull/<n> URL, or reword a number that is not a pull request" >&2; exit 2
      fi
      if sent_on "$day"; then
        echo "standup-post already posted today" >&2; exit 2
      fi
      ;;
    post)
      [[ $day =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "standup-post --send-gate post needs <today>"
      printf '%s %s\n' "$day" "$(jq -r '.tool_input.thread_ts // ""' <<<"$input")" >"$sent_file"
      ;;
    *) die "usage: standup-post --send-gate pre|post <today> <oldest> <latest> <channel>" ;;
  esac
  exit 0
}

# Prints, one per line, the bare pull request references left in $1 once every
# https://github.com/ URL is removed: #<digits>, with or without a repository
# prefix (#39, mono#70016), PR, PRs or pull, one space and digits (PR 70016,
# pull 385710), in any case, or a standalone number of 5 or more digits
# (stereo 385710), since mono and stereo pull requests have 5 and 6 digits.
# A shorter count after any other word (reviewed 120 files) passes. The digits
# must end the token, so 100%, 17:31 and #2024-planning pass. Linear keys
# (FUL-917, ECO-12345) never match.
pr_refs() {
  sed -E 's#https://github\.com/[^[:space:]<>|]*##g' <<<"$1" |
    grep -oiE '([[:alnum:]_.-]*#[0-9]+|\b(prs?|pull) [0-9]+|(^|[^[:alnum:]_.#/-])[0-9]{5,})([^[:alnum:]_%-]|$)' |
    sed -E 's/^[^[:alnum:]#]//; s/[^[:alnum:]]$//' || true
}

# Prints $1 without leading and trailing whitespace.
trim() {
  local s=$1
  s=${s#"${s%%[![:space:]]*}"}
  printf '%s' "${s%"${s##*[![:space:]]}"}"
}

# True when a draft for day $1 is saved; sets pending_ts to its thread.
pending_on() {
  local day
  [ -f "$pending_file" ] && [ -f "$draft_file" ] &&
    read -r day pending_ts <"$pending_file" && [ "$day" = "$1" ]
}

# True when the post hook recorded a landed send on day $1.
sent_on() {
  local day _
  [ -f "$sent_file" ] && read -r day _ <"$sent_file" && [ "$day" = "$1" ]
}

if [ "${1:-}" = --send-gate ]; then
  install -d -m 700 "$state_dir" || exit 2
  send_gate "${2:-}" "${3:-}" "${4:-}" "${5:-}" "${6:-}"
fi

# The Slack IDs and the team name are workspace-specific, so they live in a
# local file outside the repository. Hook mode never reads it: a shell error
# in a sourced file exits with a status other than 2, which lets the send
# through, so the main run passes the channel to the hook instead.
env_file="$HOME/.config/standup-post.env"
[ -f "$env_file" ] ||
  die "missing $env_file; copy standup-post/standup-post.env.example there and fill it in"
# shellcheck source=/dev/null
. "$env_file"
for key in STANDUP_CHANNEL STANDUP_SUBTEAM STANDUP_SELF STANDUP_TEAM; do
  [ -n "${!key:-}" ] || die "$env_file does not set $key"
done
# The IDs go into a hook command and the prompt, so allow only Slack ID shapes.
[[ $STANDUP_CHANNEL =~ ^C[A-Z0-9]+$ ]] || die "STANDUP_CHANNEL in $env_file is not a Slack channel ID"
[[ $STANDUP_SUBTEAM =~ ^S[A-Z0-9]+$ ]] || die "STANDUP_SUBTEAM in $env_file is not a Slack user group ID"
[[ $STANDUP_SELF =~ ^U[A-Z0-9]+$ ]] || die "STANDUP_SELF in $env_file is not a Slack user ID"
[[ $STANDUP_TEAM =~ ^[A-Za-z0-9][A-Za-z0-9\ ._-]*$ ]] ||
  die "STANDUP_TEAM in $env_file may hold only letters, digits, spaces, dots, underscores and hyphens"
CHANNEL=$STANDUP_CHANNEL
SUBTEAM=$STANDUP_SUBTEAM
SELF=$STANDUP_SELF
TEAM=$STANDUP_TEAM

install -d -m 700 "$state_dir"
case "${1:-}" in
  '') mode=draft ;;
  --dry-run) mode=dry-run ;;
  --show) mode=show ;;
  --approve) mode=approve ;;
  --discard) mode=discard ;;
  *) die "usage: standup-post [--dry-run|--show|--approve|--discard]" ;;
esac

# STANDUP_POST_NOW pins the clock for tests; it takes any date -d string.
now=$(date -d "${STANDUP_POST_NOW:-now}" +%s)
today=$(TZ=$ZONE date -d "@$now" +%F)

if [ "$mode" = show ]; then
  pending_on "$today" || die "no draft waiting for today"
  # A control character could hide text that --approve would post, so the
  # text approved must be the text seen.
  ! LC_ALL=C grep -q $'[\x01-\x08\x0b-\x1f\x7f]' "$draft_file" ||
    die "the draft holds control characters; run standup-post --discard"
  printf 'thread %s\n\n%s\n' "$pending_ts" "$(<"$draft_file")"
  exit 0
fi

exec 9>"$state_dir/lock"
flock -n 9 || die "another standup-post run holds $state_dir/lock"

if [ "$mode" = discard ]; then
  rm -f "$pending_file" "$draft_file"
  log "discarded the saved draft"
  exit 0
fi

if [ "$mode" != dry-run ]; then
  if sent_on "$today"; then
    printf '%s\n' "$today" >"$last_file"
  fi
  if [ -f "$last_file" ] && [ "$(<"$last_file")" = "$today" ]; then
    [ "$mode" = approve ] && die "already posted today"
    log "already posted today"
    exit 0
  fi
fi
if [ "$mode" = approve ]; then
  pending_on "$today" || die "no draft waiting for today; run standup-post first"
  draft=$(<"$draft_file")
elif [ "$mode" = draft ] && pending_on "$today"; then
  log "a draft for today is waiting: standup-post --show, then standup-post --approve"
  exit 0
fi

case $(TZ=$ZONE date -d "@$now" +%u) in
  1) back=3 ;;
  7) back=2 ;;
  *) back=1 ;;
esac
since=$(TZ=$ZONE date -d "$today -$back days" +%F)T00:00:00
oldest=$(TZ=$ZONE date -d "$today $POST_HOUR:00" +%s)
latest=$(TZ=$ZONE date -d "$today +1 day" +%s)
# The channel reads newest first, so bound the read to the hour the bot posts.
window_end=$(TZ=$ZONE date -d "$today $((POST_HOUR + 1)):00" +%s)
updated_since=$(TZ=$ZONE date -d "$today -30 days" +%F)

# The PreToolUse hook skips screening when scanner.py is absent, so check
# the files it needs here.
for f in scanner.py policy.json rules.md; do
  [ -f "$rules_dir/$f" ] || die "missing $rules_dir/$f; run make assistants"
done

# The user settings put slack_send_message under permissions.ask, and an ask
# rule beats --allowedTools in -p mode, so the run skips user settings. That
# also drops the user MCP servers, skills, plugins and hooks: Linear comes
# back through --mcp-config, Slack through --settings, the skill is read as a
# file, and the Communication Rules PreToolUse gate is copied from the user
# settings so it still screens the post.
user_settings="$HOME/.claude/settings.json"
self=$(printf '%q' "$(readlink -f "$0")")
send_tool=mcp__plugin_slack_slack__slack_send_message
settings=$(jq -c --arg self "$self" --arg tool "$send_tool" \
  --arg today "$today" --arg oldest "$oldest" --arg latest "$latest" --arg channel "$CHANNEL" '
  def gate($phase): {matcher: $tool, hooks: [{type: "command", command: "\($self) --send-gate \($phase) \($today) \($oldest) \($latest) \($channel)"}]};
  {
    enabledPlugins: {"slack@claude-plugins-official": true},
    hooks: {
      PreToolUse: ([.hooks.PreToolUse[]?
        | select(any(.hooks[]?; (.command // "") | contains("communication-rules/scanner.py")))]
        | if length > 0 then . + [gate("pre")] else . end),
      PostToolUse: [gate("post")]
    }
  }' "$user_settings") || die "cannot read $user_settings"
jq -e '.hooks.PreToolUse | length > 1' >/dev/null <<<"$settings" ||
  die "no Communication Rules PreToolUse hook in $user_settings"
# The work organisation scopes what the skill reports. The file is optional and
# read in a subshell so it cannot override the standup values.
work_env="$HOME/.config/work-context.env"
org=
# shellcheck source=/dev/null
[ -f "$work_env" ] && org=$(. "$work_env" && printf '%s' "${WORK_GITHUB_ORG:-}")
[[ -z $org || $org =~ ^[A-Za-z0-9][A-Za-z0-9-]*$ ]] || die "WORK_GITHUB_ORG in $work_env is not a GitHub organisation name"
if [ -n "$org" ]; then
  scope="The work GitHub organisation is $org."
else
  scope="No work GitHub organisation is configured, so no repository counts as work: report Linear only and leave out all GitHub activity."
fi
mcp_config='{"mcpServers":{"linear":{"type":"http","url":"https://mcp.linear.app/mcp"}}}'

skill_real=$(readlink -f "$skill_dir")
skills_real=$(dirname "$skill_real")
sessions="$skill_dir/scripts/sessions-since.sh"

draft_mode="DRAFT ONLY: do not post anything. After step c, print the draft as one fenced code block, then a line THREAD <the parent ts>, then the final line DRAFT."

if [ "$mode" = approve ]; then
  # The draft is a plain parameter value, so the shell never expands its contents.
  prompt="You run unattended to post the approved $TEAM daily standup reply. Do not ask the user anything. [standup-update]

a. First read the thread with mcp__plugin_slack_slack__slack_read_thread (channel_id $CHANNEL, the parent ts $pending_ts). If any reply other than the parent is from user $SELF, print SKIP: already replied and stop without sending.
   Otherwise call mcp__plugin_slack_slack__slack_send_message once with channel_id $CHANNEL, thread_ts $pending_ts and message set to exactly the text between the BEGIN DRAFT and END DRAFT lines below, unchanged. Never post anything else, anywhere else, or twice. If a hook denies the call, do not retry: print ERROR: <reason> and stop.
b. Read the thread with mcp__plugin_slack_slack__slack_read_thread (channel_id $CHANNEL, the parent ts $pending_ts) to confirm the reply landed and get its permalink.
c. End with exactly one final line: POSTED <permalink>, SKIP: already replied, or ERROR: <reason>.

BEGIN DRAFT
$draft
END DRAFT"
  tools=("$send_tool" mcp__plugin_slack_slack__slack_read_thread)
else
  prompt="You run unattended for the $TEAM daily standup. Do not ask the user anything. $draft_mode [standup-update]
The team is $TEAM. $scope

a. Find today's $TEAM Daily Standup thread: call mcp__plugin_slack_slack__slack_read_channel with channel_id $CHANNEL, oldest $oldest, latest $window_end and response_format detailed. The thread is the bot message whose text contains $SUBTEAM and \"Please post your daily update\". If there is none, print SKIP: no standup today and stop.
b. Read that thread with mcp__plugin_slack_slack__slack_read_thread (channel_id $CHANNEL, the parent ts). If any reply other than the parent is from user $SELF, print SKIP: already replied and stop.
c. Read $skill_dir/SKILL.md and follow it to draft the reply for the window starting $since ($ZONE time). Read files it names, such as ~/.claude/skills/slack-message/SKILL.md, with the Read tool. Run the sessions script as $sessions $since. Pass literal dates to gh and never use command substitution; for the open PR search use --updated \">=$updated_since\". Delete every field line without evidence, including Ask when the evidence does not settle it, but never Today: fill it with the team work planned for today as the skill says. Leave out the user's own initiatives (Linear issues labelled design and their pull requests). Put a blank line between sections. The draft must have a Moved: line and no template placeholders; if it cannot, print ERROR: <reason> and stop. The fenced block holds only the reply text: no Sources line and no marker.
d. End with exactly one final line: SKIP: <reason>, DRAFT, or ERROR: <reason>."

  tools=(
    mcp__plugin_slack_slack__slack_read_channel
    mcp__plugin_slack_slack__slack_read_thread
    # Read rules: ~/ is home-relative, // is absolute. Skills are symlinks, so
    # the resolved skills directory is listed too.
    "Read(~/.claude/skills/**)"
    "Read(/$skills_real/**)"
    "Read(~/.claude/projects/**)"
    "Read(~/.config/notes-repo.env)"
    "Read(~/notes/notes/**)"
    Agent
    mcp__linear__list_issues
    "Bash(gh search:*)"
    "Bash(gh pr view:*)"
    "Bash(ls:*)"
    "Bash($sessions:*)"
    "Bash($skill_real/scripts/sessions-since.sh:*)"
  )
fi

# Run outside $HOME so no project settings apply either.
cd "$state_dir"
if [ "$mode" = approve ]; then
  log "posting the approved draft to thread $pending_ts"
else
  log "drafting for the window starting $since"
fi
# Sets output, status and last from one claude run of $1.
run_claude() {
  status=0
  output=$(timeout 20m claude -p "$1" \
    --output-format text \
    --setting-sources project,local \
    --settings "$settings" \
    --mcp-config "$mcp_config" \
    --permission-mode dontAsk \
    --no-session-persistence \
    --max-turns 60 \
    --max-budget-usd 5 \
    --allowedTools "${tools[@]}" </dev/null) || status=$?
  last=$(printf '%s\n' "$output" | awk 'NF { line = $0 } END { print line }')
}

fail() {
  log "$*"
  printf '%s\n' "$output" | tail -n 20 >&2
  exit 1
}

# Prints the last fenced block of $output; fails when there is none.
fenced_draft() {
  printf '%s\n' "$output" | awk '
    /^[[:space:]]*```/ { if (open) { last = buf; found = 1; open = 0 } else { open = 1; buf = "" } next }
    open { buf = buf $0 "\n" }
    END { printf "%s", last; exit !found }'
}

# Prints why the send gate or the Communication Rules hook would deny
# posting $1, or nothing when both would let it through. The draft run never
# offers the send tool, and --approve may not reword the draft, so a saved
# draft must already pass both. The scanner must print "pass", so a scanner
# that cannot run denies.
draft_violations() {
  local refs verdict rules
  local scanner=(python3 "$rules_dir/scanner.py" --policy-json "$rules_dir/policy.json" --rules "$rules_dir/rules.md")
  refs=$(pr_refs "$1")
  if [ -n "$refs" ]; then
    printf 'It cites a pull request as a bare number: %s. Replace each with the full https://github.com/<owner>/<repo>/pull/<n> URL, or reword a number that is not a pull request.\n' "${refs//$'\n'/, }"
  fi
  verdict=$(printf '%s' "$1" | "${scanner[@]}" scan-text 2>/dev/null) || true
  if [ "$verdict" != pass ]; then
    rules=$("${scanner[@]}" block-message 2>/dev/null) || true
    printf '%s\n' "${rules:-The Communication Rules scanner blocked it.}"
  fi
  return 0
}

run_claude "$prompt"
# One redraft with the reasons, since the timer runs once a day and a denied
# draft could never be posted.
if [ "$mode" = draft ] && [ "$status" -eq 0 ] && [ "$last" = DRAFT ] &&
  draft=$(fenced_draft) && reasons=$(draft_violations "$draft") && [ -n "$reasons" ]; then
  log "the draft would be denied at --approve; redrafting once"
  run_claude "$prompt

Your earlier draft was rejected for these reasons, so draft it again without them:
$reasons"
fi

# Writes $2 to $1 through a mode 600 temporary file, so a reader never sees
# a partial file.
save() {
  local tmp
  tmp=$(mktemp "$1.XXXXXX")
  printf '%s\n' "$2" >"$tmp"
  mv -f "$tmp" "$1"
}

# The post hook's record, not the model's final line, says whether a send
# landed, so it settles the state even when the run failed after sending.
if [ "$mode" = approve ] && sent_on "$today"; then
  printf '%s\n' "$today" >"$last_file"
  rm -f "$pending_file" "$draft_file"
  [ "$status" -eq 0 ] || fail "claude exited with status $status after a send landed"
  case $last in
    'POSTED https://'*) log "posted ${last#POSTED }"; exit 0 ;;
    *) fail "a send landed but claude reported: $last" ;;
  esac
fi

[ "$status" -eq 0 ] || fail "claude exited with status $status"

case $last in
  'POSTED https://'*)
    [ "$mode" = approve ] || fail "$mode run reported a post: $last"
    fail "claude reported a post but no send landed: $last"
    ;;
  'SKIP: '*)
    if [ "$mode" = approve ]; then
      # The user replied by hand after the draft; drop it so it is never posted twice.
      [ "$last" = 'SKIP: already replied' ] || fail "unexpected result: $last"
      rm -f "$pending_file" "$draft_file"
    fi
    log "${last#SKIP: }"
    ;;
  DRAFT)
    case $mode in
      dry-run) printf '%s\n' "$output" ;;
      draft)
        # The model's text proposes the thread; the window check and the send
        # gate bound it to today's standup hour.
        thread=$(printf '%s\n' "$output" | sed -nE 's/^THREAD ([0-9]{1,12}\.[0-9]+)[[:space:]]*$/\1/p' | tail -n 1)
        [ -n "$thread" ] || fail "the draft names no THREAD <ts> line"
        if [ "${thread%%.*}" -lt "$oldest" ] || [ "${thread%%.*}" -ge "$latest" ]; then
          fail "thread $thread did not start in today's standup hour"
        fi
        # The last fenced block is the draft.
        draft=$(fenced_draft) || fail "the draft has no fenced block"
        [ -n "$(trim "$draft")" ] || fail "the fenced draft is empty"
        # Control characters could hide text from --show while --approve posts it.
        ! LC_ALL=C grep -q $'[\x01-\x08\x0b-\x1f\x7f]' <<<"$draft" ||
          fail "the draft holds control characters"
        reasons=$(draft_violations "$draft")
        [ -z "$reasons" ] || fail "the redraft would still be denied at --approve: ${reasons%%$'\n'*}"
        save "$draft_file" "$draft"
        save "$pending_file" "$today $thread"
        log "standup draft ready: standup-post --show, then standup-post --approve"
        # agent-notify reports its own errors and exits 0, so a missing
        # receiver never fails the run.
        if command -v agent-notify >/dev/null; then
          printf '{"notification_type":"permission_prompt","cwd":"standup-post"}\n' |
            agent-notify send || true
        fi
        ;;
      *) fail "claude returned a draft instead of posting" ;;
    esac
    ;;
  *)
    fail "unexpected result: $last"
    ;;
esac
