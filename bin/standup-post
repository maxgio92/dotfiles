#!/usr/bin/env bash
# Reply to today's team daily standup thread after the user approves the
# draft. The script reads and posts through the agent-slack wrapper itself;
# headless claude only drafts.
#
#   standup-post            draft today's reply, save it, notify (standup-post.timer)
#   standup-post --show     print the saved draft and its thread ts
#   standup-post --approve  post the saved draft verbatim
#   standup-post --discard  drop the saved draft
#   standup-post --dry-run  print a draft without saving it
set -euo pipefail

# The bot posts at $POST_HOUR:30 Europe/Rome while the host clock is UTC, so all date
# maths runs in the bot's timezone.
ZONE=Europe/Rome
# The hour the bot posts the EU standup thread, in $ZONE.
POST_HOUR=11

state_dir="$HOME/.local/state/standup-post"
last_file="$state_dir/last-posted"
# UTC time of the last approved post; the next draft covers work since then.
posted_at_file="$state_dir/posted-at"
sent_file="$state_dir/sent"
# The saved draft, and "<today> <thread_ts>" for the thread it answers.
draft_file="$state_dir/draft"
pending_file="$state_dir/pending"
skill_dir="$HOME/.claude/skills/standup-update"
rules_dir="$HOME/.claude/hooks/communication-rules"

log() { printf 'standup-post: %s\n' "$*" >&2; }
die() { log "$*"; exit 1; }

# Prints, one per line, the bare pull request references left in $1 once every
# https://github.com/ URL is removed: #<digits>, with or without a repository
# prefix (#39, mono#70016), PR, PRs or pull, one space and digits (PR 70016,
# pull 385710), in any case, or a standalone number of 5 or more digits
# (stereo 385710), since mono and stereo pull requests have 5 and 6 digits.
# A shorter count after any other word (reviewed 120 files) passes. The digits
# must end the token, so 100%, 17:31 and #2024-planning pass. Linear keys
# (FUL-917, ECO-12345) never match.
pr_refs() {
  sed -E 's#https://github\.com/[^[:space:]<>|]*##g' <<<"$1" |
    grep -oiE '([[:alnum:]_.-]*#[0-9]+|\b(prs?|pull) [0-9]+|(^|[^[:alnum:]_.#/-])[0-9]{5,})([^[:alnum:]_%-]|$)' |
    sed -E 's/^[^[:alnum:]#]//; s/[^[:alnum:]]$//' || true
}

# Prints $1 without leading and trailing whitespace.
trim() {
  local s=$1
  s=${s#"${s%%[![:space:]]*}"}
  printf '%s' "${s%"${s##*[![:space:]]}"}"
}

# True when a draft for day $1 is saved; sets pending_ts to its thread.
pending_on() {
  local day
  [ -f "$pending_file" ] && [ -f "$draft_file" ] &&
    read -r day pending_ts <"$pending_file" && [ "$day" = "$1" ]
}

# True when a send landed on day $1.
sent_on() {
  local day _
  [ -f "$sent_file" ] && read -r day _ <"$sent_file" && [ "$day" = "$1" ]
}

# The Slack IDs and the team name are workspace-specific, so they live in a
# local file outside the repository.
env_file="$HOME/.config/standup-post.env"
[ -f "$env_file" ] ||
  die "missing $env_file; copy standup-post/standup-post.env.example there and fill it in"
# shellcheck source=/dev/null
. "$env_file"
for key in STANDUP_CHANNEL STANDUP_SUBTEAM STANDUP_SELF STANDUP_TEAM; do
  [ -n "${!key:-}" ] || die "$env_file does not set $key"
done
# The IDs go into agent-slack arguments, a jq regex and the prompt, so allow
# only Slack ID shapes.
[[ $STANDUP_CHANNEL =~ ^C[A-Z0-9]+$ ]] || die "STANDUP_CHANNEL in $env_file is not a Slack channel ID"
[[ $STANDUP_SUBTEAM =~ ^S[A-Z0-9]+$ ]] || die "STANDUP_SUBTEAM in $env_file is not a Slack user group ID"
[[ $STANDUP_SELF =~ ^U[A-Z0-9]+$ ]] || die "STANDUP_SELF in $env_file is not a Slack user ID"
[[ $STANDUP_TEAM =~ ^[A-Za-z0-9][A-Za-z0-9\ ._-]*$ ]] ||
  die "STANDUP_TEAM in $env_file may hold only letters, digits, spaces, dots, underscores and hyphens"
CHANNEL=$STANDUP_CHANNEL
SUBTEAM=$STANDUP_SUBTEAM
SELF=$STANDUP_SELF
TEAM=$STANDUP_TEAM

install -d -m 700 "$state_dir"
case "${1:-}" in
  '') mode=draft ;;
  --dry-run) mode=dry-run ;;
  --show) mode=show ;;
  --approve) mode=approve ;;
  --discard) mode=discard ;;
  *) die "usage: standup-post [--dry-run|--show|--approve|--discard]" ;;
esac

# STANDUP_POST_NOW pins the clock for tests; it takes any date -d string.
now=$(date -d "${STANDUP_POST_NOW:-now}" +%s)
today=$(TZ=$ZONE date -d "@$now" +%F)

if [ "$mode" = show ]; then
  pending_on "$today" || die "no draft waiting for today"
  # A control character could hide text that --approve would post, so the
  # text approved must be the text seen.
  ! LC_ALL=C grep -q $'[\x01-\x08\x0b-\x1f\x7f]' "$draft_file" ||
    die "the draft holds control characters; run standup-post --discard"
  printf 'thread %s\n\n%s\n' "$pending_ts" "$(<"$draft_file")"
  exit 0
fi

exec 9>"$state_dir/lock"
flock -n 9 || die "another standup-post run holds $state_dir/lock"

if [ "$mode" = discard ]; then
  rm -f "$pending_file" "$draft_file"
  log "discarded the saved draft"
  exit 0
fi

if [ "$mode" != dry-run ]; then
  if sent_on "$today"; then
    printf '%s\n' "$today" >"$last_file"
  fi
  if [ -f "$last_file" ] && [ "$(<"$last_file")" = "$today" ]; then
    [ "$mode" = approve ] && die "already posted today"
    log "already posted today"
    exit 0
  fi
fi
if [ "$mode" = approve ]; then
  pending_on "$today" || die "no draft waiting for today; run standup-post first"
  draft=$(<"$draft_file")
  [ -n "$(trim "$draft")" ] || die "the saved draft is empty; run standup-post --discard"
elif [ "$mode" = draft ] && pending_on "$today"; then
  log "a draft for today is waiting: standup-post --show, then standup-post --approve"
  exit 0
fi

case $(TZ=$ZONE date -d "@$now" +%u) in
  1) back=3 ;;
  7) back=2 ;;
  *) back=1 ;;
esac
# Start at the last post, so work finished after it on the same day is not
# dropped. Fall back to the previous working day's midnight when there is no
# record or it is more than a week old. Transcripts and gh use UTC.
since=$(date -u -d "@$(TZ=$ZONE date -d "$today -$back days 00:00" +%s)" +%FT%T)
if [ -f "$posted_at_file" ]; then
  posted_at=$(<"$posted_at_file")
  if [[ $posted_at =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$ ]] &&
    at=$(date -u -d "${posted_at}Z" +%s 2>/dev/null) &&
    [ "$at" -le "$now" ] && [ "$at" -gt $((now - 7 * 86400)) ]; then
    since=$posted_at
  fi
fi
oldest=$(TZ=$ZONE date -d "$today $POST_HOUR:00" +%s)
latest=$(TZ=$ZONE date -d "$today +1 day" +%s)
# The channel reads newest first, so bound the read to the hour the bot posts.
window_end=$(TZ=$ZONE date -d "$today $((POST_HOUR + 1)):00" +%s)
updated_since=$(TZ=$ZONE date -d "$today -30 days" +%F)

# draft_violations screens every draft with scanner.py before it is saved
# and again before it is posted, so check the files it needs here.
for f in scanner.py policy.json rules.md; do
  [ -f "$rules_dir/$f" ] || die "missing $rules_dir/$f; run make assistants"
done

# The work organisation scopes what the skill reports. The file is optional and
# read in a subshell so it cannot override the standup values.
work_env="$HOME/.config/work-context.env"
org=
# shellcheck source=/dev/null
[ -f "$work_env" ] && org=$(. "$work_env" && printf '%s' "${WORK_GITHUB_ORG:-}")
[[ -z $org || $org =~ ^[A-Za-z0-9][A-Za-z0-9-]*$ ]] || die "WORK_GITHUB_ORG in $work_env is not a GitHub organisation name"
if [ -n "$org" ]; then
  scope="The work GitHub organisation is $org."
else
  scope="No work GitHub organisation is configured, so no repository counts as work: report Linear only and leave out all GitHub activity."
fi
mcp_config='{"mcpServers":{"linear":{"type":"http","url":"https://mcp.linear.app/mcp"}}}'


log_output() {
  printf '%s\n' "$output" | tail -n 20 >&2
}

fail() {
  log "$*"
  log_output
  exit 1
}

# Prints the last fenced block of $output; fails when there is none.
fenced_draft() {
  printf '%s\n' "$output" | awk '
    /^[[:space:]]*```/ { if (open) { last = buf; found = 1; open = 0 } else { open = 1; buf = "" } next }
    open { buf = buf $0 "\n" }
    END { printf "%s", last; exit !found }'
}

# Prints why posting $1 breaks the standup rules or the Communication Rules,
# or nothing when it passes. No hook screens the agent-slack send, so every
# draft passes here before it is saved and again before it is posted. The
# scanner must print "pass", so a scanner that cannot run denies.
draft_violations() {
  local refs verdict rules
  local scanner=(python3 "$rules_dir/scanner.py" --policy-json "$rules_dir/policy.json" --rules "$rules_dir/rules.md")
  refs=$(pr_refs "$1")
  if [ -n "$refs" ]; then
    printf 'It cites a pull request as a bare number: %s. Replace each with the full https://github.com/<owner>/<repo>/pull/<n> URL, or reword a number that is not a pull request.\n' "${refs//$'\n'/, }"
  fi
  verdict=$(printf '%s' "$1" | "${scanner[@]}" scan-text 2>/dev/null) || true
  if [ "$verdict" != pass ]; then
    rules=$("${scanner[@]}" block-message 2>/dev/null) || true
    printf '%s\n' "${rules:-The Communication Rules scanner blocked it.}"
  fi
  return 0
}

# Control characters could hide text from --show while --approve posts it.
has_control_chars() {
  LC_ALL=C grep -q $'[\x01-\x08\x0b-\x1f\x7f]' <<<"$1"
}

# Prints the issue keys of the last IMAGE_REQUESTS line outside the fenced
# blocks of $output, "none", or nothing when there is no such line.
image_request_line() {
  printf '%s\n' "$output" | awk '/^[[:space:]]*```/ { open = !open; next } !open' |
    sed -nE 's/^IMAGE_REQUESTS[[:space:]]+(.*[^[:space:]])[[:space:]]*$/\1/p' | tail -n 1
}

# Keys from the first attempt's IMAGE_REQUESTS line, which a redraft must
# still lead Today with, so answering "none" cannot dodge the rejection.
earlier_keys=()

# Prints why draft $1 does not lead Today with the image requests that the
# IMAGE_REQUESTS line of $output and earlier_keys list, or nothing when it
# does. The model reports the keys itself, so this checks the draft against
# its own Linear query, which it often skips otherwise.
image_request_violations() {
  local line keys=() key first
  # --approve posts the draft verbatim, so the marker must stay out of it.
  if grep -qE '^[[:space:]]*IMAGE_REQUESTS' <<<"$1"; then
    printf 'Print IMAGE_REQUESTS outside the fenced block.\n'
    return 0
  fi
  line=$(image_request_line)
  if [ -z "$line" ]; then
    printf 'It has no IMAGE_REQUESTS line. Query the Delivery issues assigned to you and print IMAGE_REQUESTS <keys> or IMAGE_REQUESTS none.\n'
    return 0
  fi
  [ "$line" = none ] || read -ra keys <<<"$line"
  for key in "${keys[@]}"; do
    if ! [[ $key =~ ^[A-Z]+-[0-9]+$ ]]; then
      printf 'Its IMAGE_REQUESTS line is not a list of issue keys such as DELI-123, or none.\n'
      return 0
    fi
  done
  for key in "${earlier_keys[@]}"; do
    [[ " ${keys[*]} " == *" $key "* ]] || keys+=("$key")
  done
  [ "${#keys[@]}" -eq 0 ] && return 0
  # The first non-blank line after Today:.
  first=$(printf '%s\n' "$1" | awk 'seen && NF { print; exit } /^[[:space:]]*Today:[[:space:]]*$/ { seen = 1 }')
  if [[ $first == "• image requests:"* ]]; then
    for key in "${keys[@]}"; do
      [[ $first =~ (^|[^A-Z0-9-])$key([^A-Z0-9-]|$) ]] || { first=; break; }
    done
    [ -n "$first" ] && return 0
  fi
  printf 'Today must start with • image requests: listing %s by key and name.\n' "${keys[*]}"
}

# Writes $2 to $1 through a mode 600 temporary file, so a reader never sees
# a partial file.
save() {
  local tmp
  tmp=$(mktemp "$1.XXXXXX")
  printf '%s\n' "$2" >"$tmp"
  mv -f "$tmp" "$1"
}

# True when $1 is a Slack ts that falls in today's standup hours.
in_window() {
  [[ $1 =~ ^[0-9]{1,12}\.[0-9]+$ ]] && [ "${1%%.*}" -ge "$oldest" ] && [ "${1%%.*}" -lt "$latest" ]
}

# Prints the ts of today's standup thread: the earliest top-level bot
# message in $CHANNEL between $oldest and $window_end that mentions $SUBTEAM
# and asks for the daily update. Prints nothing when there is none; fails the
# run when the read or its JSON fails.
find_thread() {
  local history
  # The channel reads newest first, so the read is bounded to the hour the bot posts.
  history=$(timeout 2m agent-slack message list "$CHANNEL" --oldest "$oldest" --latest "$window_end" --limit 200) ||
    die "cannot read channel $CHANNEL"
  # agent-slack prunes empty arrays from its output (pruneEmpty), so an hour
  # with no messages comes back as {} or {"channel_id": ...}. An object
  # carrying an error is still a failed read.
  jq -r --arg sub "$SUBTEAM" '
    if type != "object" or has("error") or ((.messages // []) | type) != "array"
    then error("no messages array") else . end
    | [(.messages // [])[]
       | select(.author.bot_id != null and (.thread_ts == null or .thread_ts == .ts)
           and ((.content // "") | test("<!subteam\\^" + $sub + "[|>]"))
           and ((.content // "") | contains("Please post your daily update")))
       | .ts]
    | sort_by(tonumber) | first // empty' <<<"$history" ||
    die "cannot parse the history of channel $CHANNEL"
}

# Prints "yes" when a reply in thread $1 other than its root is from $SELF,
# or "no". Fails the run when the read fails or the root is missing, so a
# send never follows an unread thread.
self_replied() {
  local thread_json
  thread_json=$(timeout 2m agent-slack message list "$CHANNEL" --thread-ts "$1") ||
    die "cannot read thread $1 in $CHANNEL"
  jq -r --arg root "$1" --arg self "$SELF" '
    if (.messages | type) != "array" or all(.messages[]; .ts != $root)
    then error("thread root missing") else . end
    | if any(.messages[]; .ts != $root and .author.user_id == $self) then "yes" else "no" end' <<<"$thread_json" ||
    die "cannot parse thread $1 in $CHANNEL"
}

if [ "$mode" = approve ]; then
  # Nothing screens the send itself, so the saved draft passes the same
  # checks the draft run applied, in case it changed on disk.
  ! has_control_chars "$draft" || die "the draft holds control characters; run standup-post --discard"
  reasons=$(draft_violations "$draft")
  [ -z "$reasons" ] || die "the saved draft is rejected: ${reasons%%$'\n'*} Run standup-post --discard"
  in_window "$pending_ts" || die "thread $pending_ts did not start in today's standup hours"
  thread=$pending_ts
else
  thread=$(find_thread)
  if [ -z "$thread" ]; then
    log "no standup today"
    exit 0
  fi
  in_window "$thread" || die "thread $thread did not start in today's standup hours"
fi

# A plain assignment, so a failed read stops the run under set -e.
replied=$(self_replied "$thread")
if [ "$replied" = yes ]; then
  # The user replied by hand after the draft; drop it so it is never posted twice.
  [ "$mode" = approve ] && rm -f "$pending_file" "$draft_file"
  log "already replied"
  exit 0
fi

if [ "$mode" = approve ]; then
  log "posting the approved draft to thread $thread"
  # The draft is one argument, so the shell never expands its contents.
  status=0
  output=$(timeout 2m agent-slack message send "$CHANNEL" "$draft" --thread-ts "$thread") || status=$?
  if [ "$status" -ne 0 ]; then
    # A timeout or a lost response may still have posted, so never retry
    # here: the next --approve reads the thread first and skips a landed reply.
    fail "agent-slack message send exited with status $status; run standup-post --approve again to check the thread before any resend"
  fi
  # Record the send before parsing anything, so a later failure cannot
  # lead to a second post.
  printf '%s %s\n' "$today" "$thread" >"$sent_file"
  printf '%s\n' "$today" >"$last_file"
  date -u -d "${STANDUP_POST_NOW:-now}" +%FT%T >"$posted_at_file"
  rm -f "$pending_file" "$draft_file"
  permalink=$(jq -r '.permalink // empty' <<<"$output" 2>/dev/null) || permalink=
  ts=$(jq -r '.ts // empty' <<<"$output" 2>/dev/null) || ts=
  if [[ $permalink == https://* ]]; then
    log "posted $permalink"
  elif [ -n "$ts" ]; then
    log "posted ts $ts; set ~/.config/agent-slack/workspace to the workspace URL to get a permalink"
  else
    fail "agent-slack message send succeeded but printed no ts"
  fi
  exit 0
fi

skill_real=$(readlink -f "$skill_dir")
skills_real=$(dirname "$skill_real")
sessions="$skill_dir/scripts/sessions-since.sh"

prompt="You run unattended to draft the $TEAM daily standup reply. Do not ask the user anything. DRAFT ONLY: do not post anything. [standup-update]
The team is $TEAM. $scope

a. Read $skill_dir/SKILL.md and follow it to draft the reply for the window starting $since (UTC). Read files it names, such as ~/.claude/skills/slack-message/SKILL.md, with the Read tool. Run the sessions script as $sessions $since. Pass literal dates to gh and never use command substitution; for the open PR search use --updated \">=$updated_since\". Delete every field line without evidence, including Ask when the evidence does not settle it, but never Today: fill it with the team work planned for today as the skill says. Leave out the user's own initiatives (Linear issues labelled design and their pull requests). Put a blank line between sections. The draft must have a Moved: line and no template placeholders; if it cannot, print ERROR: <reason> and stop. The fenced block holds only the reply text: no Sources line and no marker.
   Image requests are the user's issues in the Linear team named Delivery: call mcp__linear__list_issues with assignee \"me\" and team \"Delivery\", and keep the issues whose status type is neither completed nor canceled. When any are left, the first bullet under Today: must be \"• image requests: <key> <name>, <key> <name>\" listing every one of them. Outside the fenced block, print one line IMAGE_REQUESTS followed by their space-separated keys, or IMAGE_REQUESTS none when there are none.
b. Print the draft as one fenced code block, then the IMAGE_REQUESTS line from step a, then exactly one final line: DRAFT, SKIP: <reason>, or ERROR: <reason>."

# No Slack tool: the script already found the thread and posts the reply
# itself after approval.
tools=(
  # Read rules: ~/ is home-relative, // is absolute. Skills are symlinks, so
  # the resolved skills directory is listed too.
  "Read(~/.claude/skills/**)"
  "Read(/$skills_real/**)"
  "Read(~/.claude/projects/**)"
  "Read(~/.config/notes-repo.env)"
  "Read(~/notes/notes/**)"
  Agent
  mcp__linear__list_issues
  "Bash(gh search:*)"
  "Bash(gh pr view:*)"
  "Bash(ls:*)"
  "Bash($sessions:*)"
  "Bash($skill_real/scripts/sessions-since.sh:*)"
)

# Run outside $HOME so no project settings apply either.
cd "$state_dir"
log "drafting for the window starting $since"
# Sets output, status and last from one claude run of $1. User settings are
# skipped so their ask rules and plugins cannot change the run; Linear comes
# back through --mcp-config and the skill is read as a file.
run_claude() {
  status=0
  output=$(timeout 20m claude -p "$1" \
    --output-format text \
    --setting-sources project,local \
    --mcp-config "$mcp_config" \
    --permission-mode dontAsk \
    --no-session-persistence \
    --max-turns 60 \
    --max-budget-usd 5 \
    --allowedTools "${tools[@]}" </dev/null) || status=$?
  last=$(printf '%s\n' "$output" | awk 'NF { line = $0 } END { print line }')
}

run_claude "$prompt"
# One redraft with the reasons, since the timer runs once a day and a denied
# draft could never be posted.
if [ "$mode" = draft ] && [ "$status" -eq 0 ] && [ "$last" = DRAFT ] &&
  draft=$(fenced_draft) && reasons=$(draft_violations "$draft"; image_request_violations "$draft") && [ -n "$reasons" ]; then
  log "the draft was rejected; redrafting once"
  line=$(image_request_line)
  if [ "$line" != none ]; then
    read -ra earlier_keys <<<"$line"
    for key in "${earlier_keys[@]}"; do
      [[ $key =~ ^[A-Z]+-[0-9]+$ ]] || { earlier_keys=(); break; }
    done
  fi
  run_claude "$prompt

Your earlier draft was rejected for these reasons, so draft it again without them:
$reasons"
fi

[ "$status" -eq 0 ] || fail "claude exited with status $status"

case $last in
  'SKIP: '*)
    log "${last#SKIP: }"
    ;;
  DRAFT)
    case $mode in
      dry-run) printf 'thread %s\n\n%s\n' "$thread" "$output" ;;
      draft)
        # The last fenced block is the draft.
        draft=$(fenced_draft) || fail "the draft has no fenced block"
        [ -n "$(trim "$draft")" ] || fail "the fenced draft is empty"
        ! has_control_chars "$draft" || fail "the draft holds control characters"
        reasons=$(draft_violations "$draft"; image_request_violations "$draft")
        [ -z "$reasons" ] || fail "the redraft was still rejected: ${reasons%%$'\n'*}"
        save "$draft_file" "$draft"
        save "$pending_file" "$today $thread"
        log "standup draft ready: standup-post --show, then standup-post --approve"
        # agent-notify reports its own errors and exits 0, so a missing
        # receiver never fails the run.
        if command -v agent-notify >/dev/null; then
          printf '{"notification_type":"permission_prompt","cwd":"standup-post"}\n' |
            agent-notify send || true
        fi
        ;;
    esac
    ;;
  *)
    fail "unexpected result: $last"
    ;;
esac
