#!/usr/bin/env bash
# personal-watch producer: poll the four watches, enqueue hits. Run by the timer.
# timeout + </dev/null so the process always exits (claude -p can hang on
# teardown), which lets the oneshot complete and the timer reschedule.
CLAUDE="$(command -v claude || echo /home/linuxbrew/.linuxbrew/bin/claude)"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/personal-watch"
mkdir -p "$STATE/inbox" "$STATE/archive"
exec timeout 600 "$CLAUDE" -p "/personal-watch produce" \
  --allowedTools "Bash Read Write Glob Grep mcp__plugin_slack_slack__slack_search_public mcp__plugin_slack_slack__slack_read_thread mcp__linear-server__list_issues mcp__linear-server__list_comments" \
  </dev/null >>"$STATE/produce.log" 2>&1
