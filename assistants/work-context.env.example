# Copy to ~/.config/work-context.env and replace the placeholders.
# task-tracker, sizing and standup-update read it. Without it, no repository
# counts as work and Linear writes ask for the team key first.
WORK_GITHUB_ORG=<work-org>   # GitHub owner of the work repositories
LINEAR_TEAM_KEY=ABC          # Linear team key, the prefix of issue keys like ABC-123
