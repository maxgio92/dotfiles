{
  "fileSuggestion": {
    "type": "command",
    "command": "$HOME/.claude/file-suggestion.sh"
  },
  "env": {
    "USE_BUILTIN_RIPGREP": "0"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(node:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh api:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue reopen:*)",
      "Bash(gh issue transfer:*)",
      "Bash(gh issue pin:*)",
      "Bash(gh pr reopen:*)",
      "Bash(gh release:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh-review-reply:*)",
      "mcp__plugin_slack_slack__slack_send_message",
      "mcp__plugin_slack_slack__slack_add_reaction",
      "mcp__plugin_slack_slack__slack_create_canvas",
      "mcp__plugin_slack_slack__slack_update_canvas",
      "mcp__linear__save_comment",
      "mcp__linear__save_issue",
      "mcp__linear__save_diff_comment",
      "mcp__linear__submit_diff_review",
      "mcp__linear__save_document",
      "mcp__linear__save_status_update",
      "mcp__linear__save_project",
      "mcp__linear__resolve_diff_thread",
      "mcp__linear__merge_diff"
    ],
    "deny": [
      "mcp__plugin_slack_slack__slack_send_message_draft",
      "mcp__plugin_slack_slack__slack_schedule_message",
      "mcp__linear__delete_comment",
      "mcp__linear__delete_diff_comment",
      "mcp__linear__delete_status_update",
      "mcp__linear__delete_attachment",
      "Bash(gh pr lock:*)",
      "Bash(gh pr unlock:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh issue lock:*)",
      "Bash(gh issue unlock:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gh config:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "fable",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "! command -v workmux >/dev/null 2>&1 || workmux set-window-status waiting"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x $HOME/.local/share/clorch/hooks/notify_handler.sh ] || $HOME/.local/share/clorch/hooks/notify_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x $HOME/.local/share/clorch/hooks/event_handler.sh ] || CLORCH_EVENT=PermissionRequest $HOME/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x $HOME/.claude/hooks/go-gate.sh ] || $HOME/.claude/hooks/go-gate.sh file",
            "timeout": 15,
            "statusMessage": "go-gate: gofmt"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "! command -v workmux >/dev/null 2>&1 || workmux set-window-status working"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x $HOME/.local/share/clorch/hooks/event_handler.sh ] || CLORCH_EVENT=PostToolUse $HOME/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x $HOME/.local/share/clorch/hooks/event_handler.sh ] || CLORCH_EVENT=PostToolUseFailure $HOME/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x $HOME/.local/share/clorch/hooks/event_handler.sh ] || CLORCH_EVENT=PreCompact $HOME/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f $HOME/.claude/hooks/communication-rules/scanner.py ] || python3 $HOME/.claude/hooks/communication-rules/scanner.py --policy-json $HOME/.claude/hooks/communication-rules/policy.json --rules $HOME/.claude/hooks/communication-rules/rules.md claude-code PreToolUse",
            "timeout": 15,
            "statusMessage": "Communication Rules: gate"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x $HOME/.local/share/clorch/hooks/event_handler.sh ] || CLORCH_EVENT=PreToolUse $HOME/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x $HOME/.local/share/clorch/hooks/event_handler.sh ] || CLORCH_EVENT=SessionEnd $HOME/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f $HOME/.claude/hooks/communication-rules/scanner.py ] || python3 $HOME/.claude/hooks/communication-rules/scanner.py --policy-json $HOME/.claude/hooks/communication-rules/policy.json --rules $HOME/.claude/hooks/communication-rules/rules.md claude-code SessionStart",
            "timeout": 15,
            "statusMessage": "Communication Rules: reminder"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x $HOME/.local/share/clorch/hooks/event_handler.sh ] || CLORCH_EVENT=SessionStart $HOME/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f $HOME/.claude/hooks/communication-rules/scanner.py ] || python3 $HOME/.claude/hooks/communication-rules/scanner.py --policy-json $HOME/.claude/hooks/communication-rules/policy.json --rules $HOME/.claude/hooks/communication-rules/rules.md claude-code Stop",
            "timeout": 15,
            "statusMessage": "Communication Rules: final-prose check"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "! command -v workmux >/dev/null 2>&1 || workmux set-window-status done"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x $HOME/.local/share/clorch/hooks/event_handler.sh ] || CLORCH_EVENT=Stop $HOME/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x $HOME/.local/share/clorch/hooks/event_handler.sh ] || CLORCH_EVENT=SubagentStart $HOME/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x $HOME/.claude/hooks/go-gate.sh ] || $HOME/.claude/hooks/go-gate.sh final",
            "timeout": 600,
            "statusMessage": "go-gate: build + test + lint"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f $HOME/.claude/hooks/communication-rules/scanner.py ] || python3 $HOME/.claude/hooks/communication-rules/scanner.py --policy-json $HOME/.claude/hooks/communication-rules/policy.json --rules $HOME/.claude/hooks/communication-rules/rules.md claude-code SubagentStop",
            "timeout": 15,
            "statusMessage": "Communication Rules: final-prose check"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x $HOME/.local/share/clorch/hooks/event_handler.sh ] || CLORCH_EVENT=SubagentStop $HOME/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x $HOME/.local/share/clorch/hooks/event_handler.sh ] || CLORCH_EVENT=TaskCompleted $HOME/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x $HOME/.local/share/clorch/hooks/event_handler.sh ] || CLORCH_EVENT=TeammateIdle $HOME/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f $HOME/.claude/hooks/communication-rules/scanner.py ] || python3 $HOME/.claude/hooks/communication-rules/scanner.py --policy-json $HOME/.claude/hooks/communication-rules/policy.json --rules $HOME/.claude/hooks/communication-rules/rules.md claude-code UserPromptSubmit",
            "timeout": 15,
            "statusMessage": "Communication Rules: pending re-issue"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "! command -v workmux >/dev/null 2>&1 || workmux set-window-status working"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x $HOME/.local/share/clorch/hooks/event_handler.sh ] || CLORCH_EVENT=UserPromptSubmit $HOME/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "outputStyle": "house-style",
  "effortLevel": "medium",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "editorMode": "vim",
  "skipAutoPermissionPrompt": true
}
