{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "claude-opus-4-8",
  "fileSuggestion": {
    "type": "command",
    "command": "/home/massimiliano-giovagnoli/.claude/file-suggestion.sh"
  },
  "env": {
    "USE_BUILTIN_RIPGREP": "0"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status waiting"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/home/massimiliano-giovagnoli/.local/share/clorch/hooks/notify_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLORCH_EVENT=PermissionRequest /home/massimiliano-giovagnoli/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/home/massimiliano-giovagnoli/.claude/hooks/go-gate.sh file",
            "timeout": 15,
            "statusMessage": "go-gate: gofmt"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status working"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLORCH_EVENT=PostToolUse /home/massimiliano-giovagnoli/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLORCH_EVENT=PostToolUseFailure /home/massimiliano-giovagnoli/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLORCH_EVENT=PreCompact /home/massimiliano-giovagnoli/.local/share/clorch/hooks/event_handler.sh",
            "async": true
