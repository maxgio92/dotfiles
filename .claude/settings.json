{
  "fileSuggestion": {
    "type": "command",
    "command": "$HOME/.claude/file-suggestion.sh"
  },
  "env": {
    "USE_BUILTIN_RIPGREP": "0"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "mcp__codex__codex",
      "mcp__codex__codex-reply"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status waiting"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/share/clorch/hooks/notify_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLORCH_EVENT=PermissionRequest $HOME/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/go-gate.sh file",
            "timeout": 15,
            "statusMessage": "go-gate: gofmt"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status working"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLORCH_EVENT=PostToolUse $HOME/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLORCH_EVENT=PostToolUseFailure $HOME/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLORCH_EVENT=PreCompact $HOME/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/communication-rules/scanner.py --policy-json $HOME/.claude/hooks/communication-rules/policy.json --rules $HOME/.claude/hooks/communication-rules/rules.md claude-code PreToolUse",
            "timeout": 15,
            "statusMessage": "Communication Rules: gate"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLORCH_EVENT=PreToolUse $HOME/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLORCH_EVENT=SessionEnd $HOME/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/communication-rules/scanner.py --policy-json $HOME/.claude/hooks/communication-rules/policy.json --rules $HOME/.claude/hooks/communication-rules/rules.md claude-code SessionStart",
            "timeout": 15,
            "statusMessage": "Communication Rules: reminder"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLORCH_EVENT=SessionStart $HOME/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/communication-rules/scanner.py --policy-json $HOME/.claude/hooks/communication-rules/policy.json --rules $HOME/.claude/hooks/communication-rules/rules.md claude-code Stop",
            "timeout": 15,
            "statusMessage": "Communication Rules: final-prose check"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status done"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLORCH_EVENT=Stop $HOME/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLORCH_EVENT=SubagentStart $HOME/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/go-gate.sh final",
            "timeout": 600,
            "statusMessage": "go-gate: build + test + lint"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/communication-rules/scanner.py --policy-json $HOME/.claude/hooks/communication-rules/policy.json --rules $HOME/.claude/hooks/communication-rules/rules.md claude-code SubagentStop",
            "timeout": 15,
            "statusMessage": "Communication Rules: final-prose check"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLORCH_EVENT=SubagentStop $HOME/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLORCH_EVENT=TaskCompleted $HOME/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLORCH_EVENT=TeammateIdle $HOME/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/communication-rules/scanner.py --policy-json $HOME/.claude/hooks/communication-rules/policy.json --rules $HOME/.claude/hooks/communication-rules/rules.md claude-code UserPromptSubmit",
            "timeout": 15,
            "statusMessage": "Communication Rules: pending re-issue"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status working"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLORCH_EVENT=UserPromptSubmit $HOME/.local/share/clorch/hooks/event_handler.sh",
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "editorMode": "vim",
  "skipAutoPermissionPrompt": true
}
